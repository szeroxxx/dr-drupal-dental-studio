# Public origin of the deployed site — used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. Forward appointment requests to a CRM / automation webhook (Zapier, Make, n8n, custom API).
# When unset, the booking form hands the request to WhatsApp instead.
APPOINTMENT_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer <secret>` to the webhook.
APPOINTMENT_WEBHOOK_SECRET=
